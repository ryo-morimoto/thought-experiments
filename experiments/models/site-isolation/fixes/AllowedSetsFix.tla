---------------------------- MODULE AllowedSetsFix ----------------------------
(* fixes/FIXES.md: observe/AllowedSets.tla against the fixed SpecIsolation.  *)
(* AllowedRows.tla is generated by observe/driver/mkallowed.py and then      *)
(* patched by fixes/check.sh so that w014 is the <img> it is:                *)
(* ImageResult(OA, unsafe-none, r, FALSE), FALSE = no TLS at wptserve :8000.  *)
(* Mutants are reported in three groups: the 43 of observe/RESULTS.md, the   *)
(* "neg:" and the "false:" forms of the new decision ids (FixIds).           *)
EXTENDS AllowedSets

FixIdsL  == S("none")!FixIds
NegNew   == {"neg:" \o d : d \in FixIdsL}
FalseNew == S("none")!FixMutants
Old43    == Ms \ NegNew
AllMs    == Ms \cup FalseNew

KilledIn(G, b) == {m \in G : KillRows(m, b) # {}}
EquivIn(G)     == {m \in G : SameOnRows(m)}

PrintFix == \A b \in B0 :
  /\ PrintT(<<"fix-out", b, Cardinality(Out("none", b)), Out("none", b)>>)
  /\ PrintT(<<"fix-counts", b,
       <<"old43", Cardinality(Old43), "killed", Cardinality(KilledIn(Old43, b)),
         "equiv", Cardinality(EquivIn(Old43))>>,
       <<"neg-new", Cardinality(NegNew), "killed", KilledIn(NegNew, b), "equiv", EquivIn(NegNew)>>,
       <<"false-new", Cardinality(FalseNew), "killed",
         {<<m, KillRows(m, b)>> : m \in KilledIn(FalseNew, b)}, "equiv", EquivIn(FalseNew)>>>>)
  /\ PrintT(<<"fix-rescuing", b,
       {<<m, RescueRows(m, b)>> : m \in {x \in AllMs : RescueRows(x, b) # {}}}>>)
===============================================================================
