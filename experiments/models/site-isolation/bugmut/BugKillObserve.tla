---------------------------- MODULE BugKillObserve ----------------------------
(* bugmut/RESULTS.md: kills of BugMutants!All on the 109 WPT rows, with the  *)
(* rule of ../observe/AllowedSets.tla. AllowedRows.tla and Observed.tla are  *)
(* generated by ../observe/driver/mkallowed.py (run.sh does it in scratch).  *)
EXTENDS FiniteSets, TLC, AllowedRows, Observed
CONSTANT CfgName
BM == INSTANCE BugMutants
Ms == BM!All
ObsRows(b) == DOMAIN Obs(b)
KillRows(m, b) == {r \in ObsRows(b) :
  Obs(b)[r] \subseteq Allowed("none", r) /\ ~(Obs(b)[r] \subseteq Allowed(m, r))}
Same(m) == \A r \in Rows : Allowed(m, r) = Allowed("none", r)
PrintK == \A b \in Browsers : \A m \in Ms :
  PrintT(<<"k", "observe", CfgName, b, m, Cardinality(KillRows(m, b)), Same(m)>>)
Init == dummy = 0
Next == UNCHANGED dummy
Spec == Init /\ [][Next]_dummy
===============================================================================
