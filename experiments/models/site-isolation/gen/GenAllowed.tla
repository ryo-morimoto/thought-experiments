------------------------------ MODULE GenAllowed ------------------------------
(* gen/RESULTS.md: inclusion and mutant kills for the generated scenarios,  *)
(* as observe/AllowedSets.tla does for the 109 WPT rows. GenRows.tla is      *)
(* generated by driver/mkallowed.py. A mutant m is killed by browser b when  *)
(* some row's observation is inside the unmutated model's set and outside   *)
(* m's. Mutants: MechMutants (neg:), the named Mutants and FixMutants.      *)
EXTENDS Naturals, Sequences, FiniteSets, TLC, GenRows
CONSTANTS COIChoices, WithPP
VARIABLE dummy
G(m) == INSTANCE GenModel WITH Mutant <- m

Ms == G("none")!SI!MechMutants \cup G("none")!SI!Mutants \cup G("none")!SI!FixMutants
N == Len(Rows)
A(m, r) == G(m)!Allowed(Scen[Rows[r].s], Rows[r].i, Rows[r].k, COIChoices, WithPP)
Base == [r \in 1..N |-> A("none", r)]
MT   == [m \in Ms |-> [r \in 1..N |-> A(m, r)]]

ObsIdx(b) == {r \in 1..N : Rows[r][b] # {}}
Out(b)    == {r \in ObsIdx(b) : ~(Rows[r][b] \subseteq Base[r])}
Inside(b) == ObsIdx(b) \ Out(b)
KillRows(m, b) == {r \in Inside(b) : ~(Rows[r][b] \subseteq MT[m][r])}
RescueRows(m, b) == {r \in Out(b) : Rows[r][b] \subseteq MT[m][r]}
Equivalent == {m \in Ms : MT[m] = Base}
Killed(b)  == {m \in Ms : KillRows(m, b) # {}}
Ids(S) == {Rows[r].id : r \in S}
Pick(S) == CHOOSE x \in S : TRUE
Some(S) == IF Cardinality(S) <= 3 THEN Ids(S)
           ELSE LET x1 == Pick(S) x2 == Pick(S \ {x1}) x3 == Pick(S \ {x1, x2}) IN Ids({x1, x2, x3})

PrintGen ==
  /\ PrintT(<<"cfg", COIChoices, WithPP, "rows", N, "mutants", Cardinality(Ms)>>)
  /\ PrintT(<<"equivalent", Equivalent>>)
  /\ \A b \in Browsers :
       /\ PrintT(<<"counts", b, "observed", Cardinality(ObsIdx(b)), "inside", Cardinality(Inside(b)),
                   "out", Cardinality(Out(b)), "killed", Cardinality(Killed(b)),
                   "survived-nonequivalent", (Ms \ Killed(b)) \ Equivalent>>)
       /\ PrintT(<<"killed", b, {<<m, Cardinality(KillRows(m, b))>> : m \in Killed(b)}>>)
       /\ PrintT(<<"out-of-model", b, {<<Rows[r].id, Rows[r][b], Base[r]>> : r \in Out(b)}>>)
       /\ PrintT(<<"rescuing", b, {<<m, Cardinality(RescueRows(m, b))>> :
                                    m \in {x \in Ms : RescueRows(x, b) # {}}}>>)
\* Kill rows of the mutants named in KillDetail (a few examples each).
KillDetail == {"false:secure-ctx-top", "false:nav-coep-adherence", "false:nav-corp-check",
               "false:mc-ancestor", "false:mc-upgrade", "false:mc-block",
               "neg:secure-ctx-top", "neg:nav-coep-adherence", "neg:nav-corp-check"}
PrintDetail == \A b \in Browsers :
  PrintT(<<"kill-detail", b, {<<m, Cardinality(KillRows(m, b)), Some(KillRows(m, b))>> : m \in KillDetail}>>)

Init == dummy = 0
Next == UNCHANGED dummy
Spec == Init /\ [][Next]_dummy
===============================================================================
