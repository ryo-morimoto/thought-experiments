----------------------------- MODULE AllowedRows -----------------------------
(* Generated by observe/driver/mkallowed.py from ../wpt-cases.tsv. For each *)
(* row r and Mutant value m, the set of outputs SpecIsolation allows.       *)
EXTENDS Naturals, Sequences, FiniteSets, TLC
VARIABLE dummy
\* Values of the model's parameter COIChoice to range over.
CONSTANT COIChoices
S(m) == INSTANCE SpecIsolation WITH Mutant <- m, dummy <- dummy
 \* Origins do not depend on Mutant.
OA == S("none")!OA
OAwww == S("none")!OAwww
OAwww2 == S("none")!OAwww2
OB == S("none")!OB
OAhttp == S("none")!OAhttp
OAwwwhttp == S("none")!OAwwwhttp
OBhttp == S("none")!OBhttp
Proj(v) == IF v = "error" THEN "error" ELSE "load"
ProjSet(X) == {Proj(v) : v \in X}
RowSeq == <<"w001", "w002", "w003", "w004", "w005", "w006", "w007", "w008", "w009", "w010", "w011", "w012", "w013", "w014", "w015", "w016", "w017", "w018", "w019", "w020", "w021", "w022", "w023", "w024", "w025", "w026", "w027", "w028", "w029", "w030", "w031", "w032", "w033", "w034", "w035", "w036", "w037", "w038", "w039", "w040", "w041", "w042", "w043", "w044", "w045", "w046", "w047", "w048", "w049", "w050", "w051", "w052", "w053", "w054", "w055", "w056", "w057", "w058", "w059", "w060", "w061", "w062", "w063", "w064", "w065", "w066", "w067", "w068", "w069", "w070", "w071", "w072", "w073", "w074", "w075", "w076", "w077", "w078", "w079", "w080", "w081", "w082", "w083", "w084", "w085", "w086", "w087", "w088", "w089", "w090", "w091", "w092", "w093", "w094", "w095", "w096", "w097", "w098", "w099", "w100", "w101", "w102", "w103", "w104", "w105", "w106", "w107", "w108", "w109">>
Rows == {RowSeq[i] : i \in 1..Len(RowSeq)}
Allowed(m, r) ==
